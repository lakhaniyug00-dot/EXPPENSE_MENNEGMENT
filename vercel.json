{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/", "destination": "/dilyex.html" },
    { "source": "/dilyex", "destination": "/dilyex.html" },
    { "source": "/khata", "destination": "/khata.html" },
    { "source": "/pagar", "destination": "/pagar.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
